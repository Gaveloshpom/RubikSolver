<?xml version="1.0" encoding="utf-8"?>
<!--
  This project has zero NuGet package dependencies, so we pin its sources to empty.
  This is only here because the sandbox that built this project had no access to nuget.org;
  it's harmless to keep (nothing to restore) but feel free to delete it.
  Deliberately NOT placed at the repo root or in tests/Rubik.Tests, so that project still
  sees your machine's normal NuGet sources (needed for the real xunit package).
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
